# =============================================================================
# IQPlus → JetStream Publisher — production env example (FreeBSD deploy)
# =============================================================================
# Copy this file to iqplus-publisher.env (gitignored), fill in the secrets,
# upload to host as /home/landa/iqplus-publisher/bin/iqplus-publisher.env
# with chmod 0600.
#
# Loaded automatically by the binary from <exe-dir>/iqplus-publisher.env
# (see cmd/iqplus-publisher/main.go loadEnvFile()).
# =============================================================================

ENV=production

# IQPlus TCP feed
IQPLUS_HOST=103.114.143.237
IQPLUS_PORT=8888
IQPLUS_USER=                                # fill in before deploy
IQPLUS_PASS_MD5=                            # md5(plain_password) lowercase hex
IQPLUS_DIAL_TIMEOUT=10s
IQPLUS_READ_TIMEOUT=60s
IQPLUS_RECONNECT_DELAY=5s
IQPLUS_BUFFER_SIZE=200000
IQPLUS_SEND_TIMEOUT=0
IQPLUS_TYPES_EXCLUDE=

# NATS JetStream
NATS_URL=nats://10.10.8.2:4222
NATS_TOKEN=                                 # bearer token (required for prod)
NATS_CLIENT_NAME=iqplus-publisher-freebsd
NATS_PUBLISH_TIMEOUT=10s
NATS_ASYNC_MAX_PENDING=32000
NATS_DRAIN_TIMEOUT=30s
NATS_ENFORCE_STREAM=true
PUBLISHER_SCHEMA_VERSION=v1
STATS_INTERVAL=30s
