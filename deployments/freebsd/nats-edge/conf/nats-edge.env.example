# =============================================================================
# nats-edge env — copy ke nats-edge.env (mode 0600), upload ke FreeBSD VM
# di /home/landa/nats-edge/conf/nats-edge.env
# =============================================================================
# Loaded oleh ../scripts/start.sh sebelum exec daemon(8) → nats-server.
# Token ini DIPISAH dari main NATS — boundary keamanan beda.

# Token edge — minimal 32 char random, jangan reuse main token.
# Dipakai client lokal (iqplus-publisher) untuk konek ke 127.0.0.1:4222.
# Generate: openssl rand -hex 32
NATS_TOKEN=

# Token leafnode — auth ke main NATS hub (10.10.8.2:7422). Harus sama
# dengan token leaf yang di-set di main `leafnodes.authorization.token`.
# Generate: openssl rand -hex 32
LEAF_TOKEN=
