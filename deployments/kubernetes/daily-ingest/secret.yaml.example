# All env vars for daily-ingest in one Secret. Apply via:
#   kubectl apply -f secret.yaml -n tuai
#
# Copy to secret.yaml (gitignored) and fill in DB_PASSWORD and
# QUESTDB_AUTH_PASSWORD.
apiVersion: v1
kind: Secret
metadata:
  name: tuai-be-daily-ingest-env
  namespace: tuai
  labels:
    app.kubernetes.io/name: tuai-be-daily-ingest
    app.kubernetes.io/component: stock-batch
type: Opaque
stringData:
  ENV: "production"

  # Postgres — destination (stock.prices_daily)
  DB_HOST: "10.10.8.10"
  DB_PORT: "5432"
  DB_USER: "tuai_tan"
  DB_PASSWORD: ""                             # fill in
  DB_NAME: "tuai"
  DB_SSLMODE: "disable"
  DB_MAX_CONNS: "5"
  DB_MIN_CONNS: "1"

  # QuestDB — source (raw `trades` ticks via HTTP /exec)
  QUESTDB_HTTP_URL: "http://10.10.8.10:9000"
  QUESTDB_TABLE: "trades"
  QUESTDB_TS_COLUMN: "timestamp"
  QUESTDB_AUTH_USER: "tuai_tan"
  QUESTDB_AUTH_PASSWORD: ""                   # fill in
  QUESTDB_HTTP_TIMEOUT: "60s"

  # Daemon schedule — fires once daily at this WIB time, ingests TODAY's
  # WIB calendar date. 17:00 = post-close: all Type 27 (resend) trades
  # with broker codes are already in the QuestDB `trades` table.
  DAILY_INGEST_RUN_AT: "17:00"
  DAILY_INGEST_TARGET: "today"
  DAILY_INGEST_DEFAULT_MARKET: "RG"
