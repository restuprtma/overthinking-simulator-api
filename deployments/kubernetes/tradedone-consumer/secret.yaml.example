# All env vars for tradedone-consumer in one Secret. Apply via:
#   kubectl apply -f secret.yaml -n tuai
#
# Copy this file to secret.yaml (gitignored) and fill in NATS_TOKEN and
# REDIS_PASSWORD.
apiVersion: v1
kind: Secret
metadata:
  name: tuai-be-tradedone-consumer-env
  namespace: tuai
  labels:
    app.kubernetes.io/name: tuai-be-tradedone-consumer
    app.kubernetes.io/component: stock-consumer
type: Opaque
stringData:
  ENV: "production"

  # NATS JetStream — Type 40 (Trade Done) frames live on IDX_TICK
  NATS_URL: "nats://10.10.8.2:4222"
  NATS_TOKEN: ""                              # fill in
  NATS_STREAM: "IDX_TICK"
  NATS_DURABLE: "tradedone-volume-profile"
  NATS_FILTER_SUBJECT: "idx.tradedone.>"
  NATS_ACK_WAIT: "30s"
  NATS_MAX_ACK_PENDING: "5000"

  # Redis — volume profile snapshots (HASH per stock, field per price level)
  REDIS_ADDR: "10.10.8.31:6379"
  REDIS_PASSWORD: ""                          # fill in
  REDIS_DB: "14"
  REDIS_KEY_PREFIX: "tradedone"
  REDIS_STATE_TTL: "25h"

  # Service
  STATS_INTERVAL: "30s"
