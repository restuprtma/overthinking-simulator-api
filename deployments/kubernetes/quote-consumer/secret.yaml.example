# All env vars for quote-consumer in one Secret. Apply via:
#   kubectl apply -f secret.yaml -n tuai
#
# Copy this file to secret.yaml (gitignored) and fill in NATS_TOKEN and
# REDIS_PASSWORD.
apiVersion: v1
kind: Secret
metadata:
  name: tuai-be-quote-consumer-env
  namespace: tuai
  labels:
    app.kubernetes.io/name: tuai-be-quote-consumer
    app.kubernetes.io/component: stock-consumer
type: Opaque
stringData:
  ENV: "production"

  # NATS JetStream — Type 14 (Quote) frames on stream IDX_QUOTE
  NATS_URL: "nats://10.10.8.2:4222"
  NATS_TOKEN: ""                              # fill in
  NATS_STREAM: "IDX_QUOTE"
  NATS_DURABLE: "quote-state-cache"
  NATS_FILTER_SUBJECT: "idx.quote.>"
  NATS_ACK_WAIT: "30s"
  NATS_MAX_ACK_PENDING: "10000"

  # Redis — quote state hash per stock (FID 0..79 from Type 14 Quote).
  # DB index allocation (project-wide):
  #   running-trade-consumer  → REDIS_DB=11
  #   quote-consumer          → REDIS_DB=12
  #   meta-consumer           → REDIS_DB=13
  #   tradedone-consumer      → REDIS_DB=14
  REDIS_ADDR: "10.10.8.31:6379"
  REDIS_PASSWORD: ""                          # fill in
  REDIS_DB: "12"
  REDIS_KEY_PREFIX: "quote"
  REDIS_STATE_TTL: "25h"

  # Service
  STATS_INTERVAL: "30s"
