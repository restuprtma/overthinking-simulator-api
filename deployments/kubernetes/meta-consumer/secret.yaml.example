apiVersion: v1
kind: Secret
metadata:
  name: meta-consumer-env
  namespace: tuai
  labels:
    app.kubernetes.io/name: meta-consumer
    app.kubernetes.io/component: stock-consumer
type: Opaque
stringData:
  ENV: "production"

  NATS_URL: "nats://10.10.8.2:4222"
  NATS_TOKEN: ""                              # fill in
  NATS_STREAM: "IDX_META"
  NATS_DURABLE: "meta-state-cache"
  # Default filter subjects (csv): idx.status.>,idx.activity.>,idx.summary.>,idx.top20.>
  # Override only if you want a narrower set.
  # NATS_FILTER_SUBJECTS: ""
  NATS_ACK_WAIT: "30s"
  NATS_MAX_ACK_PENDING: "1000"

  REDIS_ADDR: "10.10.8.10:6379"
  REDIS_PASSWORD: ""                          # fill in
  REDIS_DB: "13"
  REDIS_KEY_PREFIX: "market"
  REDIS_STATE_TTL: "25h"

  STATS_INTERVAL: "30s"
