# All env vars for resend-trade-consumer in one Secret. Apply via:
#   kubectl apply -f secret.yaml -n tuai
#
# Copy this file to secret.yaml (gitignored) and fill in NATS_TOKEN and
# QUESTDB_AUTH_PASSWORD.
apiVersion: v1
kind: Secret
metadata:
  name: resend-trade-consumer-env
  namespace: tuai
  labels:
    app.kubernetes.io/name: resend-trade-consumer
    app.kubernetes.io/component: stock-consumer
type: Opaque
stringData:
  ENV: "production"

  # NATS JetStream
  NATS_URL: "nats://10.10.8.2:4222"
  NATS_TOKEN: ""                              # fill in
  NATS_STREAM: "IDX_TICK"
  NATS_DURABLE: "resend-trade-backfill"
  NATS_FILTER_SUBJECT: "idx.resend.trade.>"
  NATS_ACK_WAIT: "30s"
  NATS_MAX_ACK_PENDING: "10000"             # tuned for 2-pod scale

  # QuestDB — single destination table for every Type 27 row.
  QUESTDB_ADDRESS: "10.10.8.51:9000"
  QUESTDB_TABLE: "trades"
  QUESTDB_AUTH_USER: "tuai_tan"
  QUESTDB_AUTH_PASSWORD: ""                   # fill in
  QUESTDB_AUTO_FLUSH_ROWS: "2000"             # larger batch under multi-pod load
  QUESTDB_AUTO_FLUSH_INT: "300ms"             # faster ack-to-durable

  # Service
  STATS_INTERVAL: "30s"
  FLUSH_ON_TICK: "true"
  FLUSH_TIMEOUT: "10s"
