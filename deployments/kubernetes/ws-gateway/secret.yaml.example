# Single Secret for ws-gateway. Apply via:
#   kubectl apply -f secret.yaml -n tuai
#
# Copy to secret.yaml (gitignored) and fill in NATS_TOKEN, REDIS_PASSWORD.
apiVersion: v1
kind: Secret
metadata:
  name: ws-gateway-env
  namespace: tuai
  labels:
    app.kubernetes.io/name: ws-gateway
    app.kubernetes.io/component: stock-gateway
type: Opaque
stringData:
  ENV: "production"

  # NATS — subscribes to idx.candle.> for live candle broadcast.
  # The publisher of those subjects is running-trade-consumer with
  # ENABLE_CANDLE_PUBLISHER=true. Until that is enabled, ws-gateway will
  # idle (subscribed but no traffic).
  NATS_URL: "nats://10.10.8.2:4222"
  NATS_TOKEN: ""                              # fill in
  CANDLE_SUBJECT_PREFIX: "idx.candle"

  # Redis — reads OHLCV bar snapshots written by running-trade-consumer's RedisSink.
  # MUST match running-trade-consumer: same instance, same DB, same key prefix.
  REDIS_ADDR: "10.10.8.10:6379"
  REDIS_PASSWORD: ""                          # fill in
  REDIS_DB: "11"
  REDIS_KEY_PREFIX: "candle"

  # HTTP / WebSocket
  HTTP_PORT: "8081"
  # Comma-separated allowed Origin values for WS upgrade. Empty = allow all
  # (only safe behind a trusted reverse proxy or for dev). Fill in once the
  # frontend domain is known, e.g. "https://app.tuai.id,https://tuai.id".
  WS_ALLOWED_ORIGINS: ""
  WS_HANDSHAKE_TIMEOUT: "10s"
