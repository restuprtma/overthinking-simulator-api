# All env vars for running-trade-consumer in one Secret. Apply via:
#   kubectl apply -f secret.yaml -n tuai
#
# Copy this file to secret.yaml (gitignored) and fill in the secret values
# (NATS_TOKEN, REDIS_PASSWORD, QUESTDB_AUTH_PASSWORD).
apiVersion: v1
kind: Secret
metadata:
  name: tuai-be-running-trade-consumer-env
  namespace: tuai
  labels:
    app.kubernetes.io/name: tuai-be-running-trade-consumer
    app.kubernetes.io/component: stock-consumer
type: Opaque
stringData:
  ENV: "production"

  # NATS JetStream — Type 15 (Trade Done live) frames on IDX_TICK
  NATS_URL: "nats://10.10.8.2:4222"
  NATS_TOKEN: ""                              # fill in
  NATS_STREAM: "IDX_TICK"
  # Keep durable name stable to preserve the JetStream consumer cursor
  # across the rename; renaming would force a full DeliverAll replay.
  NATS_DURABLE: "ohlcv-aggregator"
  NATS_FILTER_SUBJECT: "idx.trade.>"
  NATS_ACK_WAIT: "30s"
  NATS_MAX_ACK_PENDING: "5000"

  # Redis — live OHLCV bar snapshots (HASH per stock per timeframe)
  REDIS_ADDR: "10.10.8.31:6379"
  REDIS_PASSWORD: ""                          # fill in
  REDIS_DB: "11"
  REDIS_KEY_PREFIX: "candle"
  REDIS_BAR_TTL: "25h"

  # QuestDB — raw tick sink, table running_trades (broker codes masked "--")
  QUESTDB_ADDRESS: "10.10.8.51:9000"
  QUESTDB_TABLE: "running_trades"
  QUESTDB_AUTH_USER: "tuai_tan"
  QUESTDB_AUTH_PASSWORD: ""                   # fill in
  QUESTDB_AUTO_FLUSH_ROWS: "1000"
  QUESTDB_AUTO_FLUSH_INT: "500ms"

  # Aggregator
  OHLCV_TIMEFRAMES: "1m,5m,15m,1h"
  STATS_INTERVAL: "30s"
