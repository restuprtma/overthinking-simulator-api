# All env vars for nbs-consumer in one Secret. Apply via:
#   kubectl apply -f secret.yaml -n tuai
#
# Copy this file to secret.yaml (gitignored) and fill in NATS_TOKEN and
# QUESTDB_AUTH_PASSWORD.
apiVersion: v1
kind: Secret
metadata:
  name: tuai-be-nbs-consumer-env
  namespace: tuai
  labels:
    app.kubernetes.io/name: tuai-be-nbs-consumer
    app.kubernetes.io/component: stock-consumer
type: Opaque
stringData:
  ENV: "production"

  # NATS JetStream — IDX_META holds NBS subjects (Type 58 + 59)
  NATS_URL: "nats://10.10.8.2:4222"
  NATS_TOKEN: ""                              # fill in
  NATS_STREAM: "IDX_META"
  NATS_DURABLE: "nbs-aggregator"              # existing durable on main, has 20M+ backlog
  NATS_FILTER_SUBJECT: "idx.nbs.>"
  NATS_ACK_WAIT: "30s"
  NATS_MAX_ACK_PENDING: "5000"

  # QuestDB — two tables, one per record-type semantic view.
  # Bypass HAProxy: hit 10.10.8.51 directly (per jetstream-disk-upgrade-2026-05-08
  # follow-up + iqplus-eod-investigation-2026-04-30 §9 — HAProxy is the bottleneck).
  QUESTDB_ADDRESS: "10.10.8.51:9000"
  QUESTDB_STOCK_TABLE: "nbs_stock"            # Type 58 destination
  QUESTDB_BROKER_TABLE: "nbs_broker"          # Type 59 destination
  QUESTDB_AUTH_USER: "tuai_tan"
  QUESTDB_AUTH_PASSWORD: ""                   # fill in
  QUESTDB_AUTO_FLUSH_ROWS: "2000"             # match resend-trade burst size
  QUESTDB_AUTO_FLUSH_INT: "300ms"

  # Service
  STATS_INTERVAL: "30s"
  FLUSH_ON_TICK: "true"
  FLUSH_TIMEOUT: "10s"
