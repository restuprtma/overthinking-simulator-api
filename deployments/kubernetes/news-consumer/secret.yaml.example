# Single Secret for news-consumer. Apply via:
#   kubectl apply -f secret.yaml -n tuai
#
# Copy to secret.yaml (gitignored) and fill in NATS_TOKEN and the MONGO_URI
# password.
apiVersion: v1
kind: Secret
metadata:
  name: news-consumer-env
  namespace: tuai
  labels:
    app.kubernetes.io/name: news-consumer
    app.kubernetes.io/component: stock-consumer
type: Opaque
stringData:
  ENV: "production"

  # NATS JetStream
  NATS_URL: "nats://10.10.8.2:4222"
  NATS_TOKEN: ""                              # fill in
  NATS_STREAM: "IDX_NEWS"
  NATS_DURABLE: "news-indexer"
  NATS_FILTER_SUBJECT: "idx.news.>"
  NATS_ACK_WAIT: "60s"
  NATS_MAX_ACK_PENDING: "500"

  # MongoDB — destination. Note the URL-encoded password (* → %2A).
  MONGO_URI: "mongodb://tuai_tan:<PASSWORD>@10.10.8.10:27017/?authSource=admin"
  MONGO_DATABASE: "tuai"
  MONGO_COLLECTION: "news"
  MONGO_CONNECT_TIMEOUT: "5s"
  MONGO_WRITE_TIMEOUT: "5s"

  # Multi-packet assembler — IDX news frames span multiple Type 25 packets.
  NEWS_BUFFER_STALE_AFTER: "10m"
  NEWS_BUFFER_SWEEP: "1m"

  STATS_INTERVAL: "30s"
