# =============================================================================
# Order Book Consumer (event-sourced from Type 16 Order + Type 15 Trade)
# =============================================================================
# Reconstructs full L2 book from per-event stream — sub-second freshness.
# Output: Redis db 9 (cold-start source for ws-gateway) + NATS subjects
#   idx.orderbook.delta.<stock>      live deltas (idempotent, throttled 100ms)
#   idx.orderbook.reset.<stock|all>  session reset signal (Type 57 trigger)
#
# Per-service env file. Copy to .env (gitignored) and fill secrets.
# =============================================================================

ENV=production

# -----------------------------------------------------------------------------
# NATS JetStream — source (subscribes to Type 16 + 15 + 57)
# -----------------------------------------------------------------------------
NATS_URL=nats://10.10.8.2:4222
NATS_TOKEN=                                # bearer token (blank = no auth)
NATS_CLIENT_NAME=                          # default: orderbook-consumer-<hostname>
NATS_STREAM=IDX_TICK
NATS_DURABLE=orderbook-events              # durable consumer name
NATS_FILTER_SUBJECTS=                      # blank = "idx.order.>,idx.trade.>,idx.status.session"
NATS_ACK_WAIT=30s
NATS_MAX_ACK_PENDING=20000

# -----------------------------------------------------------------------------
# NATS — publisher (delta + reset for ws-gateway fanout)
# Defaults to the same broker as NATS_URL/NATS_TOKEN above. Override only if
# the publisher path needs to go to a different cluster (rare).
# -----------------------------------------------------------------------------
NATS_PUBLISH_URL=                          # default: NATS_URL
NATS_PUBLISH_TOKEN=                        # default: NATS_TOKEN
NATS_PUBLISH_PREFIX=idx.orderbook          # ws-gateway subscribes <prefix>.delta.> + <prefix>.reset.>

# -----------------------------------------------------------------------------
# Redis — orderbook snapshot sink (cold-start source for ws-gateway)
#
# DB index convention across stock consumers:
#   running-trade-consumer  → REDIS_DB=11
#   quote-consumer          → REDIS_DB=12
#   meta-consumer           → REDIS_DB=13
#   tradedone-consumer      → REDIS_DB=14
#   nbs-consumer            → REDIS_DB=15
#   orderbook-consumer      → REDIS_DB=9     ← this service
# -----------------------------------------------------------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=9
REDIS_KEY_PREFIX=orderbook
REDIS_STATE_TTL=25h

# -----------------------------------------------------------------------------
# Snapshotter — debounced background flush to Redis + NATS delta publish.
# Interval = lebih kecil → lebih realtime tapi lebih banyak Redis/NATS ops.
# 100ms = sub-second freshness, ~10 cycles/sec, fine for IDX peak rate.
# -----------------------------------------------------------------------------
SNAPSHOT_INTERVAL=100ms
SNAPSHOT_FLUSH_TIMEOUT=5s

# -----------------------------------------------------------------------------
# Service
# -----------------------------------------------------------------------------
STATS_INTERVAL=30s

# =============================================================================
# Local dev convenience block (uncomment when running outside the cluster)
# =============================================================================
# ENV=development
# NATS_URL=nats://10.10.8.2:4222                 # production NATS for live IDX data
# NATS_DURABLE=orderbook-events-local-$USER      # unique durable per dev to avoid splitting prod
# REDIS_ADDR=localhost:6379                      # local Redis for isolation
# REDIS_PASSWORD=
