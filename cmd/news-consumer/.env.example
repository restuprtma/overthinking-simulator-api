# =============================================================================
# News Consumer
# =============================================================================
# Subscribes to idx.news.> (Type 36), reassembles multi-packet news, and
# inserts the complete articles into MongoDB collection `news`.
#
# Per-service env file. Copy to .env (gitignored) and fill secrets.
#
# Lookup order:
#   1. $NEWS_CONSUMER_ENV_FILE
#   2. ./cmd/news-consumer/.env
#   3. <exe-dir>/.env
#   4. <exe-dir>/news-consumer.env
# =============================================================================

ENV=production

# -----------------------------------------------------------------------------
# NATS JetStream — source
# -----------------------------------------------------------------------------
NATS_URL=nats://10.10.8.2:4222
NATS_TOKEN=                                # bearer token (blank = no auth)
NATS_CLIENT_NAME=                          # default: news-consumer-<hostname>
NATS_STREAM=IDX_NEWS
NATS_DURABLE=news-indexer
NATS_FILTER_SUBJECT=idx.news.>
NATS_ACK_WAIT=60s
NATS_MAX_ACK_PENDING=500

# -----------------------------------------------------------------------------
# MongoDB — destination
# URI examples:
#   mongodb://user:pass@host:27017/?authSource=admin
#   mongodb://host:27017                                 (no auth)
#   mongodb+srv://user:pass@cluster.mongodb.net          (Atlas)
# -----------------------------------------------------------------------------
MONGO_URI=
MONGO_DATABASE=tuai
MONGO_COLLECTION=news
MONGO_CONNECT_TIMEOUT=5s
MONGO_WRITE_TIMEOUT=5s

# -----------------------------------------------------------------------------
# Multi-packet assembler
# -----------------------------------------------------------------------------
NEWS_BUFFER_STALE_AFTER=10m                # drop incomplete buffers older than this
NEWS_BUFFER_SWEEP=1m                       # how often to scan for stale buffers

# -----------------------------------------------------------------------------
# Service
# -----------------------------------------------------------------------------
STATS_INTERVAL=30s
