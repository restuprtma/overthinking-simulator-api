# =============================================================================
# NBS Consumer (Net Buy/Sell — bandar / foreign flow analytics)
# =============================================================================
# Subscribes to idx.nbs.> (Type 58 + Type 59) and writes every snapshot
# to QuestDB:
#   - Type 58 (NBS Stock)  → table `nbs_stock`
#   - Type 59 (NBS Broker) → table `nbs_broker`
#
# Per-service env file. Copy to .env (gitignored) and fill secrets.
# =============================================================================

ENV=production

# -----------------------------------------------------------------------------
# NATS JetStream — source
# -----------------------------------------------------------------------------
NATS_URL=nats://10.10.8.2:4222
NATS_TOKEN=                                # bearer token (blank for no auth)
NATS_CLIENT_NAME=                          # default: nbs-consumer-<hostname>
NATS_STREAM=IDX_META
NATS_DURABLE=nbs-aggregator
NATS_FILTER_SUBJECT=idx.nbs.>
NATS_ACK_WAIT=30s
NATS_MAX_ACK_PENDING=5000

# -----------------------------------------------------------------------------
# QuestDB — dual-table destination (HTTP ILP)
# Bypass HAProxy: 10.10.8.51 direct, not 10.10.8.10 (HAProxy is the
# bottleneck per iqplus-eod-investigation-2026-04-30.md §9).
# -----------------------------------------------------------------------------
QUESTDB_ADDRESS=10.10.8.51:9000
QUESTDB_STOCK_TABLE=nbs_stock              # Type 58 destination
QUESTDB_BROKER_TABLE=nbs_broker            # Type 59 destination
QUESTDB_TOKEN=                             # optional bearer token
QUESTDB_AUTH_USER=tuai_tan
QUESTDB_AUTH_PASSWORD=                     # fill in
QUESTDB_AUTO_FLUSH_ROWS=1000
QUESTDB_AUTO_FLUSH_INT=500ms

# -----------------------------------------------------------------------------
# Service
# -----------------------------------------------------------------------------
STATS_INTERVAL=30s
FLUSH_ON_TICK=true
FLUSH_TIMEOUT=10s
