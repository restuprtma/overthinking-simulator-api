# =============================================================================
# Trade Done Consumer (volume profile per stock × price)
# =============================================================================
# Subscribes to idx.tradedone.> (Type 40), maintains a per-(stock, price)
# cumulative volume snapshot in Redis.
#
# Per-service env file. Copy to .env (gitignored) and fill secrets.
# =============================================================================

ENV=production

# -----------------------------------------------------------------------------
# NATS JetStream — source
# -----------------------------------------------------------------------------
NATS_URL=nats://10.10.8.2:4222
NATS_TOKEN=                                # bearer token (blank for no auth)
NATS_CLIENT_NAME=                          # default: tradedone-consumer-<hostname>
NATS_STREAM=IDX_TICK
NATS_DURABLE=tradedone-volume-profile
NATS_FILTER_SUBJECT=idx.tradedone.>
NATS_ACK_WAIT=30s
NATS_MAX_ACK_PENDING=5000

# -----------------------------------------------------------------------------
# Redis — volume profile sink
# DB index allocation (project-wide):
#   running-trade-consumer     → REDIS_DB=11
#   quote-consumer     → REDIS_DB=12
#   meta-consumer      → REDIS_DB=13
#   tradedone-consumer → REDIS_DB=14
# -----------------------------------------------------------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=14
REDIS_KEY_PREFIX=tradedone
REDIS_STATE_TTL=25h

# -----------------------------------------------------------------------------
# Service
# -----------------------------------------------------------------------------
STATS_INTERVAL=30s
