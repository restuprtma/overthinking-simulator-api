# =============================================================================
# WS Gateway — multi-channel WebSocket + REST snapshot for trading FE
# =============================================================================
# Per-service env file. Copy to .env (gitignored) and fill in the secrets.
#
# Loaded automatically by cmd/ws-gateway/main.go. Lookup order:
#   1. $WS_GATEWAY_ENV_FILE          (explicit path)
#   2. ./cmd/ws-gateway/.env         (repo root via `go run`)
#   3. <exe-dir>/.env                (sibling to binary)
#   4. <exe-dir>/ws-gateway.env      (alt sibling style)
#
# Routes served (see internal/modules/stock/ws_gateway/handler/handler.go):
#   GET /healthz                  liveness + v1 channel registry
#   GET /ws/candles               LEGACY candle-only WS (backward compat)
#   GET /ws/v1                    UNIFIED channel-multiplex WS
#                                 (orderbook + candle + future channels)
#   GET /api/v1/orderbook/:code   REST snapshot fallback (SSR / debug)
#
# AUTH: this binary has NO authentication. Production must front it with
# a reverse proxy that validates session/JWT before the WS upgrade.
# =============================================================================

ENV=production

# -----------------------------------------------------------------------------
# NATS — shared connection for ALL channels (candle, orderbook, future).
# Each channel plugin subscribes to its own subject pattern via this conn.
# -----------------------------------------------------------------------------
NATS_URL=nats://10.10.8.2:4222
NATS_TOKEN=
NATS_CLIENT_NAME=                          # default: ws-gateway-<hostname>

# -----------------------------------------------------------------------------
# Redis — shared host + password; each channel uses its own DB index
# because go-redis clients are per-DB. The gateway opens one client per
# channel (candle, orderbook) against the same Redis server.
# -----------------------------------------------------------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Candle channel (matches running-trade-consumer's Redis sink + publisher).
#
# Subject pattern subscribed: <CANDLE_SUBJECT_PREFIX>.<stock>.<tf>
# Snapshot key pattern:       <CANDLE_REDIS_KEY_PREFIX>:<stock>:<tf>
#
# Backward compat: if REDIS_DB / REDIS_KEY_PREFIX are set, they override
# CANDLE_REDIS_DB / CANDLE_REDIS_KEY_PREFIX (legacy env files keep working).
# -----------------------------------------------------------------------------
CANDLE_REDIS_DB=11
CANDLE_REDIS_KEY_PREFIX=candle
CANDLE_SUBJECT_PREFIX=idx.candle

# -----------------------------------------------------------------------------
# Orderbook channel (matches orderbook-consumer's Redis sink + NATS sink).
#
# Subjects subscribed:
#   <ORDERBOOK_SUBJECT_PREFIX>.delta.<stock>   live deltas (idempotent)
#   <ORDERBOOK_SUBJECT_PREFIX>.reset.<stock>   session reset signal
#   <ORDERBOOK_SUBJECT_PREFIX>.reset.all       global reset
#
# Snapshot key pattern:
#   <ORDERBOOK_REDIS_KEY_PREFIX>:<stock>:bid     HASH price → JSON {l,f,lf,ff}
#   <ORDERBOOK_REDIS_KEY_PREFIX>:<stock>:ask     HASH
#   <ORDERBOOK_REDIS_KEY_PREFIX>:<stock>:_meta   HASH seq, top_*, totals, phase
# -----------------------------------------------------------------------------
ORDERBOOK_REDIS_DB=9
ORDERBOOK_REDIS_KEY_PREFIX=orderbook
ORDERBOOK_SUBJECT_PREFIX=idx.orderbook

# -----------------------------------------------------------------------------
# HTTP server
# -----------------------------------------------------------------------------
HTTP_PORT=8081

# Comma-separated allow list for the WebSocket Origin header. Empty value
# permits all origins — fine for dev, NEVER for production. The reverse
# proxy in front of this service is the real origin gate; this is just
# defence-in-depth.
WS_ALLOWED_ORIGINS=

WS_HANDSHAKE_TIMEOUT=10s

# =============================================================================
# Local dev convenience block (uncomment when running outside the cluster)
# =============================================================================
# NATS_URL=nats://localhost:4222
# REDIS_ADDR=localhost:6379
# CANDLE_REDIS_DB=11
# ORDERBOOK_REDIS_DB=9
# WS_ALLOWED_ORIGINS=                          # leave empty for any-origin dev
# ENV=development
