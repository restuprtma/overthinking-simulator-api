# =============================================================================
# IQPlus → JetStream Publisher
# =============================================================================
# Per-service env file. Copy to .env (gitignored) and fill in the secrets.
#
# Loaded automatically by cmd/iqplus-publisher/main.go. Lookup order:
#   1. $IQPLUS_PUBLISHER_ENV_FILE       (explicit path)
#   2. ./.env                            (cwd)
#   3. ./cmd/iqplus-publisher/.env       (repo root)
#   4. <exe-dir>/.env                    (FreeBSD deploy)
#   5. <exe-dir>/iqplus-publisher.env    (FreeBSD deploy, sibling style)
#
# Process env always overrides file values — safe to leave secrets in the
# file for local dev and inject via systemd Environment= in prod.
# =============================================================================

# Logger format: "production" = JSON, anything else = console
ENV=production

# -----------------------------------------------------------------------------
# IQPlus TCP feed (source)
# -----------------------------------------------------------------------------
IQPLUS_HOST=103.114.143.237
IQPLUS_PORT=8888
IQPLUS_USER=
IQPLUS_PASS_MD5=                          # md5(plain_password) lowercase hex
IQPLUS_DIAL_TIMEOUT=10s
IQPLUS_READ_TIMEOUT=60s
IQPLUS_RECONNECT_DELAY=5s
# Sized for IDX opening burst — 50k+ trades flushed in first seconds after
# 09:00:00. Old default 10000 caused silent TCP drops (~22% loss on BBCA/BMRI).
IQPLUS_BUFFER_SIZE=200000
# 0 = block on full buffer (backpressures TCP, preferred).
# Positive value = drop after that timeout (counts in tcp_dropped stat).
IQPLUS_SEND_TIMEOUT=0

# Phase 1 throttling — exclude high-volume / Phase 2 record types from publish.
# See docs/infra/topology.md §7.2.
# Example:
#   IQPLUS_TYPES_EXCLUDE=16,26,27        (skip Order + Resend Order/Trade)
IQPLUS_TYPES_EXCLUDE=

# -----------------------------------------------------------------------------
# NATS JetStream destination
# Stream selection is per-subject (see docs/JetStream/streams.md):
#   IDX_TICK / IDX_QUOTE / IDX_META / IDX_NEWS
# -----------------------------------------------------------------------------
NATS_URL=nats://10.10.8.2:4222
NATS_TOKEN=                                # bearer token (leave blank for no-auth)
NATS_CLIENT_NAME=                          # default: iqplus-publisher-<hostname>
NATS_PUBLISH_TIMEOUT=10s
# Async-pending PER stream. With 4 streams, total in-flight = 4 * this.
# 32000/stream = 128k total which absorbs IDX opening burst comfortably.
NATS_ASYNC_MAX_PENDING=32000
NATS_DRAIN_TIMEOUT=30s
NATS_ENFORCE_STREAM=true                   # set false during initial bring-up before all 4 streams exist
PUBLISHER_SCHEMA_VERSION=v1
STATS_INTERVAL=30s
