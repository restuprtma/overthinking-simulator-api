# =============================================================================
# Resend Order Handler — Type 26 Resend Order → QuestDB `orders`
# =============================================================================
# Subscribes to idx.resend.order.> (Type 26), parses each row with
# orderbook-consumer's Order parser, and writes every row to a single
# QuestDB table (`orders`).
#
# IDX vendor emits Type 26 after market close with the real broker codes
# that were masked as "--" in live Type 16 events. DEDUP UPSERT KEYS on
# QuestDB protects against duplicates if a row is re-processed.
#
# Type 26 wire layout matches Type 16 (10 fields), but only HHMMSS is
# embedded — the date is taken from the envelope's frame Date stamp.
# Late post-midnight deliveries are auto-rolled back one day so orders
# land on the actual trading day.
#
# Per-service env file. Copy to .env (gitignored) and fill secrets.
# =============================================================================

ENV=production

# -----------------------------------------------------------------------------
# NATS JetStream — source
# -----------------------------------------------------------------------------
NATS_URL=nats://10.10.8.2:4222
NATS_TOKEN=
NATS_CLIENT_NAME=                          # default: resend-order-consumer-<hostname>
NATS_STREAM=IDX_TICK
NATS_DURABLE=resend-order-backfill
NATS_FILTER_SUBJECT=idx.resend.order.>
NATS_ACK_WAIT=30s
NATS_MAX_ACK_PENDING=5000

# -----------------------------------------------------------------------------
# QuestDB — single destination table.
# -----------------------------------------------------------------------------
QUESTDB_ADDRESS=10.10.8.51:9000
QUESTDB_TABLE=orders
QUESTDB_TOKEN=
QUESTDB_AUTH_USER=
QUESTDB_AUTH_PASSWORD=
QUESTDB_AUTO_FLUSH_ROWS=1000
QUESTDB_AUTO_FLUSH_INT=500ms

# -----------------------------------------------------------------------------
# Service
# -----------------------------------------------------------------------------
STATS_INTERVAL=30s
FLUSH_ON_TICK=true                         # belt-and-suspenders flush every stats tick
FLUSH_TIMEOUT=10s
