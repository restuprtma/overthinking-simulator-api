# =============================================================================
# Resend Trade Handler — Type 27 Resend Trade → QuestDB `trades`
# =============================================================================
# Subscribes to idx.resend.trade.> (Type 27), parses each row with
# running-trade-consumer's Trade parser, and writes every row to a single
# QuestDB table.
#
# IDX vendor emits Type 27 in two batches per session: mid-day around
# noon WIB and post-close (sometimes delivered late, past midnight).
# Both batches go to the same table; DEDUP UPSERT KEYS on QuestDB
# protects against duplicates if a row is re-processed.
#
# Per-service env file. Copy to .env (gitignored) and fill secrets.
# =============================================================================

ENV=production

# -----------------------------------------------------------------------------
# NATS JetStream — source
# -----------------------------------------------------------------------------
NATS_URL=nats://10.10.8.2:4222
NATS_TOKEN=
NATS_CLIENT_NAME=                          # default: resend-trade-consumer-<hostname>
NATS_STREAM=IDX_TICK
NATS_DURABLE=resend-trade-backfill
NATS_FILTER_SUBJECT=idx.resend.trade.>
NATS_ACK_WAIT=30s
NATS_MAX_ACK_PENDING=5000

# -----------------------------------------------------------------------------
# QuestDB — single destination table.
# -----------------------------------------------------------------------------
QUESTDB_ADDRESS=10.10.8.51:9000
QUESTDB_TABLE=trades
QUESTDB_TOKEN=
QUESTDB_AUTH_USER=
QUESTDB_AUTH_PASSWORD=
QUESTDB_AUTO_FLUSH_ROWS=1000
QUESTDB_AUTO_FLUSH_INT=500ms

# -----------------------------------------------------------------------------
# Service
# -----------------------------------------------------------------------------
STATS_INTERVAL=30s
FLUSH_ON_TICK=true                         # belt-and-suspenders flush every stats tick
FLUSH_TIMEOUT=10s
