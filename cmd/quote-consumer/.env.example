# =============================================================================
# Quote State Consumer
# =============================================================================
# Per-service env file. Copy to .env (gitignored) and fill in the secrets.
#
# Loaded automatically by cmd/quote-consumer/main.go. Lookup order:
#   1. $QUOTE_CONSUMER_ENV_FILE         (explicit path)
#   2. ./cmd/quote-consumer/.env        (repo root via `go run`)
#   3. <exe-dir>/.env                   (FreeBSD deploy)
#   4. <exe-dir>/quote-consumer.env     (FreeBSD deploy, sibling style)
# =============================================================================

ENV=production

# -----------------------------------------------------------------------------
# NATS JetStream — source
# -----------------------------------------------------------------------------
NATS_URL=nats://10.10.8.2:4222
NATS_TOKEN=                                # bearer token (blank for no auth)
NATS_CLIENT_NAME=                          # default: quote-consumer-<hostname>
NATS_STREAM=IDX_QUOTE
NATS_DURABLE=quote-state-cache
NATS_FILTER_SUBJECT=idx.quote.>
NATS_ACK_WAIT=30s
NATS_MAX_ACK_PENDING=10000

# -----------------------------------------------------------------------------
# Redis — quote state hash sink
# Use a different DB index than other consumers to keep keyspaces separate.
#   running-trade-consumer  → REDIS_DB=11
#   quote-consumer  → REDIS_DB=12
# -----------------------------------------------------------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=12
REDIS_KEY_PREFIX=quote
REDIS_STATE_TTL=25h                        # survives next pre-open before auto-evict

# -----------------------------------------------------------------------------
# Service
# -----------------------------------------------------------------------------
STATS_INTERVAL=30s
