# =============================================================================
# Daily Ingest (QuestDB → Postgres stock.prices_daily)
# =============================================================================
# Per-service env file. Copy to .env (gitignored) and fill in the secrets.
#
# Loaded automatically by cmd/daily-ingest/main.go. Lookup order:
#   1. $DAILY_INGEST_ENV_FILE         (explicit path)
#   2. ./cmd/daily-ingest/.env        (repo root via `go run`)
#   3. <exe-dir>/.env                 (FreeBSD deploy)
#   4. <exe-dir>/daily-ingest.env     (FreeBSD deploy, sibling style)
#
# Process env always overrides file values.
# =============================================================================

ENV=production

# -----------------------------------------------------------------------------
# Postgres — destination (stock.prices_daily)
# Same DB_* shape as cmd/api so DSN behaves identically.
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tuai
DB_SSLMODE=disable

# Pool tuning — defaults from internal/database. The ingest only needs a
# couple of connections (one batch per day), so feel free to lower MaxConns.
DB_MAX_CONNS=5
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_PERIOD=1m
DB_CONNECT_TIMEOUT=5s

# -----------------------------------------------------------------------------
# QuestDB — source (raw `trades` ticks)
# Use the HTTP query endpoint (default 9000), NOT the ILP port (9009).
# -----------------------------------------------------------------------------
QUESTDB_HTTP_URL=http://localhost:9000
QUESTDB_TABLE=trades
# Designated timestamp column. Default `timestamp`. If your live schema uses
# `ts` (per docs/infra/topology.md) override here. Verify with:
#   curl -G 'http://localhost:9000/exec' --data-urlencode 'query=SHOW COLUMNS FROM trades'
QUESTDB_TS_COLUMN=timestamp
# Auth: bearer token takes precedence if both groups are set.
QUESTDB_BEARER_TOKEN=
QUESTDB_AUTH_USER=
QUESTDB_AUTH_PASSWORD=
QUESTDB_HTTP_TIMEOUT=60s

# -----------------------------------------------------------------------------
# Ingest behaviour
# -----------------------------------------------------------------------------
# Fallback market code used ONLY when QuestDB returns NULL for the `market`
# column on a row — i.e. legacy data written before the column was added.
# Live data has market populated per-row by running-trade-consumer / resend-trade-consumer
# (their IDX_MARKET env), so this only matters for historical backfill.
DAILY_INGEST_DEFAULT_MARKET=RG

# Daemon mode fire time (HH:MM in Asia/Jakarta). Default 17:00 = post-close.
# All Type 15 trades are in QuestDB by then; Type 27 resend (broker-code
# backfill, ~18:00+) doesn't change OHLCV so we don't have to wait for it.
DAILY_INGEST_RUN_AT=17:00

# Which trading day the daemon ingests when it fires.
#   today     — ingest the WIB calendar date the daemon woke up on (use
#               with RUN_AT >= 17:00 WIB so all trades are settled).
#   yesterday — ingest the previous WIB day (use with early-AM RUN_AT).
DAILY_INGEST_TARGET=today
