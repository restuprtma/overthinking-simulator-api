# =============================================================================
# Running Order Consumer — Type 16 live Order → QuestDB `running_orders`
# =============================================================================
# Subscribes to idx.order.> (Type 16, live), parses each row with
# orderbook-consumer's Order parser, and writes every event raw to a
# single QuestDB table (`running_orders`).
#
# Mirrors the running_trades half of running-trade-consumer for orders. Live
# broker codes are masked as "--"; the broker-real archive lives in the
# `orders` table populated by cmd/resend-order-consumer.
#
# Per-service env file. Copy to .env (gitignored) and fill secrets.
# =============================================================================

ENV=production

# -----------------------------------------------------------------------------
# NATS JetStream — source
# -----------------------------------------------------------------------------
NATS_URL=nats://10.10.8.2:4222
NATS_TOKEN=
NATS_CLIENT_NAME=                          # default: running-order-consumer-<hostname>
NATS_STREAM=IDX_TICK
NATS_DURABLE=running-order-consumer
NATS_FILTER_SUBJECT=idx.order.>
NATS_ACK_WAIT=30s
NATS_MAX_ACK_PENDING=5000

# -----------------------------------------------------------------------------
# QuestDB — single destination table.
# -----------------------------------------------------------------------------
QUESTDB_ADDRESS=10.10.8.51:9000
QUESTDB_TABLE=running_orders
QUESTDB_TOKEN=
QUESTDB_AUTH_USER=
QUESTDB_AUTH_PASSWORD=
QUESTDB_AUTO_FLUSH_ROWS=1000
QUESTDB_AUTO_FLUSH_INT=500ms

# -----------------------------------------------------------------------------
# Service
# -----------------------------------------------------------------------------
STATS_INTERVAL=30s
FLUSH_ON_TICK=true                         # belt-and-suspenders flush every stats tick
FLUSH_TIMEOUT=10s
