# =============================================================================
# Running Trade Consumer (Type 15 → running_trades + 1m/5m/15m/1h/4h OHLCV bars)
# =============================================================================
# Per-service env file. Copy to .env (gitignored) and fill in the secrets.
#
# Loaded automatically by cmd/running-trade-consumer/main.go. Lookup order:
#   1. $RUNNING_TRADE_CONSUMER_ENV_FILE         (explicit path)
#   2. ./cmd/running-trade-consumer/.env        (repo root via `go run`)
#   3. <exe-dir>/.env                   (FreeBSD deploy)
#   4. <exe-dir>/running-trade-consumer.env     (FreeBSD deploy, sibling style)
#
# Process env always overrides file values.
# =============================================================================

ENV=production

# -----------------------------------------------------------------------------
# NATS JetStream — source
# -----------------------------------------------------------------------------
NATS_URL=nats://10.10.8.2:4222
NATS_TOKEN=                                # bearer token (blank for no auth)
NATS_CLIENT_NAME=                          # default: running-trade-consumer-<hostname>
NATS_STREAM=IDX_TICK
NATS_DURABLE=ohlcv-aggregator                  # keep stable to preserve JetStream consumer cursor
NATS_FILTER_SUBJECT=idx.trade.>
NATS_ACK_WAIT=30s
NATS_MAX_ACK_PENDING=5000

# -----------------------------------------------------------------------------
# Redis — live bar sink
# Use a different DB index than other services to keep keyspaces separate.
# -----------------------------------------------------------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=11
REDIS_KEY_PREFIX=candle
REDIS_BAR_TTL=25h                          # survives next pre-open before auto-evict

# -----------------------------------------------------------------------------
# QuestDB — historical tick sink (HTTP ILP)
# -----------------------------------------------------------------------------
QUESTDB_ADDRESS=localhost:9000             # HTTP ILP port (NOT 9009 TCP)
QUESTDB_TABLE=running_trades
QUESTDB_TOKEN=                             # bearer token (alternative to basic auth)
QUESTDB_AUTH_USER=
QUESTDB_AUTH_PASSWORD=
QUESTDB_AUTO_FLUSH_ROWS=1000
QUESTDB_AUTO_FLUSH_INT=500ms

# -----------------------------------------------------------------------------
# Aggregator + service
# -----------------------------------------------------------------------------
# Comma-separated Go durations. Aggregator maintains one bar per (stock,tf)
# in parallel, so adding more timeframes multiplies Redis HSET / NATS
# publish ops per tick by N. At 5 TFs and ~5000 ticks/s peak that's still
# trivial for both backends.
OHLCV_TIMEFRAMES=1m,5m,15m,1h,4h
STATS_INTERVAL=30s

# -----------------------------------------------------------------------------
# Candle broadcast publisher (for ws-gateway / WebSocket fan-out)
# -----------------------------------------------------------------------------
# When enabled, every aggregator Update / Close fires a JSON message to
# NATS subject `<CANDLE_SUBJECT_PREFIX>.<stock>.<tf>` (e.g. idx.candle.BBCA.1m).
# Uses NATS core (NOT JetStream) — fire-and-forget, broadcast-only, no
# durability. WS clients re-fetch from Redis on reconnect if they miss
# updates.
ENABLE_CANDLE_PUBLISHER=false

# Defaults to NATS_URL / NATS_TOKEN above when blank.
CANDLE_NATS_URL=
CANDLE_NATS_TOKEN=
CANDLE_NATS_CLIENT_NAME=                   # default: candle-pub-running-trade-consumer-<hostname>
CANDLE_SUBJECT_PREFIX=idx.candle
