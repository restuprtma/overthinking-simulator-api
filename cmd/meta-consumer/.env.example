# =============================================================================
# Meta Consumer (low-volume market metadata)
# =============================================================================
# Subscribes to:
#   idx.status.>     (Type 13 Control + Type 57 Trading Status)
#   idx.activity.>   (Type 39 Stock Activity)
#   idx.summary.>    (Type 130 Trading Summary per stype × board)
#   idx.top20.>      (Type 17 Top 20 lists)
#
# Per-service env file. Copy to .env (gitignored) and fill the secrets.
#
# Lookup order:
#   1. $META_CONSUMER_ENV_FILE
#   2. ./cmd/meta-consumer/.env
#   3. <exe-dir>/.env
#   4. <exe-dir>/meta-consumer.env
# =============================================================================

ENV=production

# -----------------------------------------------------------------------------
# NATS JetStream — source
# -----------------------------------------------------------------------------
NATS_URL=nats://10.10.8.2:4222
NATS_TOKEN=                                # bearer token (blank for no auth)
NATS_CLIENT_NAME=                          # default: meta-consumer-<hostname>
NATS_STREAM=IDX_META
NATS_DURABLE=meta-state-cache

# Override the multi-filter list if needed (CSV, server-side OR).
# Default (when blank): "idx.status.>,idx.activity.>,idx.summary.>,idx.top20.>"
NATS_FILTER_SUBJECTS=

NATS_ACK_WAIT=30s
NATS_MAX_ACK_PENDING=1000

# -----------------------------------------------------------------------------
# Redis — meta state hash sink
# DB index allocation (project-wide):
#   running-trade-consumer  → REDIS_DB=11
#   quote-consumer  → REDIS_DB=12
#   meta-consumer   → REDIS_DB=13
# -----------------------------------------------------------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=13
REDIS_KEY_PREFIX=market
REDIS_STATE_TTL=25h

# -----------------------------------------------------------------------------
# Service
# -----------------------------------------------------------------------------
STATS_INTERVAL=30s
